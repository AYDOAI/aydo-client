<?xml version='1.0' encoding='utf-8'?>
<widget id="ai.aydo" version="1.1.242" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>AYDO</name>
    <description>AYDO - Bridging IoT to Web3</description>
    <author email="info@aydo.ai" href="https://www.aydo.ai/">AYDO Team</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <preference name="ScrollEnabled" value="false" />
    <preference name="android-minSdkVersion" value="21" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="BackupWebStorage" value="none" />
    <preference name="APPCENTER_ANALYTICS_ENABLE_IN_JS" value="true" />
    <preference name="APPCENTER_CRASHES_ALWAYS_SEND" value="true" />
    <preference name="AllowInlineMediaPlayback" value="true" />
    <platform name="android">
        <allow-intent href="market:*" />
        <icon density="ldpi" src="src/assets/icons/android/drawable-ldpi-icon.png" />
        <icon density="mdpi" src="src/assets/icons/android/drawable-mdpi-icon.png" />
        <icon density="hdpi" src="src/assets/icons/android/drawable-hdpi-icon.png" />
        <icon density="xhdpi" src="src/assets/icons/android/drawable-xhdpi-icon.png" />
        <icon density="xxhdpi" src="src/assets/icons/android/drawable-xxhdpi-icon.png" />
        <icon density="xxxhdpi" src="src/assets/icons/android/drawable-xxxhdpi-icon.png" />
        <config-file parent="/*" target="AndroidManifest.xml">
            <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
        </config-file>
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
        <preference name="StatusBarOverlaysWebView" value="false" />
        <preference name="StatusBarBackgroundColor" value="#181A33" />
        <icon height="57" src="src/assets/icons/ios/icon.png" width="57" />
        <icon height="114" src="src/assets/icons/ios/icon@2x.png" width="114" />
        <icon height="40" src="src/assets/icons/ios/icon-40.png" width="40" />
        <icon height="80" src="src/assets/icons/ios/icon-40@2x.png" width="80" />
        <icon height="120" src="src/assets/icons/ios/icon-40@3x.png" width="120" />
        <icon height="50" src="src/assets/icons/ios/icon-50.png" width="50" />
        <icon height="100" src="src/assets/icons/ios/icon-50@2x.png" width="100" />
        <icon height="60" src="src/assets/icons/ios/icon-60.png" width="60" />
        <icon height="120" src="src/assets/icons/ios/icon-60@2x.png" width="120" />
        <icon height="180" src="src/assets/icons/ios/icon-60@3x.png" width="180" />
        <icon height="72" src="src/assets/icons/ios/icon-72.png" width="72" />
        <icon height="144" src="src/assets/icons/ios/icon-72@2x.png" width="144" />
        <icon height="76" src="src/assets/icons/ios/icon-76.png" width="76" />
        <icon height="152" src="src/assets/icons/ios/icon-76@2x.png" width="152" />
        <icon height="167" src="src/assets/icons/ios/icon-83.5@2x.png" width="167" />
        <icon height="29" src="src/assets/icons/ios/icon-small.png" width="29" />
        <icon height="58" src="src/assets/icons/ios/icon-small@2x.png" width="58" />
        <icon height="87" src="src/assets/icons/ios/icon-small@3x.png" width="87" />
        <icon height="1024" src="src/assets/icons/ios/icon-1024.png" width="1024" />
        <config-file parent="NSPhotoLibraryUsageDescription" platform="ios" target="*-Info.plist">
            <string>This app needs access to your Photo Library to include a screenshot with feedback foo.</string>
        </config-file>
        <config-file parent="NSCameraUsageDescription" platform="ios" target="*-Info.plist">
            <string>Allow to scan member's pass</string>
        </config-file>
        <config-file parent="NSMicrophoneUsageDescription" platform="ios" target="*-Info.plist">
            <string>AYDO uses your microphone to make calls.</string>
        </config-file>
        <config-file parent="NSBonjourServices" target="*-Info.plist">
            <array>
                <string>_http._tcp.</string>
            </array>
        </config-file>
        <config-file parent="NSLocalNetworkUsageDescription" target="*-Info.plist">
            <string>Local hub discovery.</string>
        </config-file>
        <icon height="20" src="src/assets/icons/ios/icon-20.png" width="20" />
        <icon height="40" src="src/assets/icons/ios/icon-20@2x.png" width="40" />
        <icon height="60" src="src/assets/icons/ios/icon-20@3x.png" width="60" />
        <icon height="29" src="src/assets/icons/ios/icon-29.png" width="29" />
        <icon height="58" src="src/assets/icons/ios/icon-29@2x.png" width="58" />
        <icon height="87" src="src/assets/icons/ios/icon-29@3x.png" width="87" />
        <icon height="48" src="src/assets/icons/ios/icon-24@2x.png" width="48" />
        <icon height="55" src="src/assets/icons/ios/icon-27.5@2x.png" width="55" />
        <icon height="88" src="src/assets/icons/ios/icon-44@2x.png" width="88" />
        <icon height="172" src="src/assets/icons/ios/icon-86@2x.png" width="172" />
        <icon height="196" src="src/assets/icons/ios/icon-98@2x.png" width="196" />
        <icon height="216" src="src/assets/icons/ios/icon-108@2x.png" width="216" />
    </platform>
    <edit-config file="*-Info.plist" mode="merge" target="NSCameraUsageDescription">
        <string>To scan barcodes</string>
    </edit-config>
    <edit-config file="*-Info.plist" mode="merge" target="NSFaceIDUsageDescription">
        <string>Use FaceID for authentication</string>
    </edit-config>
    <pods-config ios-min-version="9.0" use-frameworks="true">
    </pods-config>
    <plugin name="cordova-plugin-statusbar" spec="2.4.2" />
    <plugin name="cordova-plugin-ionic-keyboard" spec="^2.0.5" />
    <plugin name="cordova-plugin-speechrecognition" spec="1.2.0" />
    <plugin name="cordova-plugin-splashscreen" spec="5.0.2" />
    <plugin name="cordova-plugin-brightness" spec="0.2.0" />
    <plugin name="cordova-plugin-device" spec="2.0.2" />
    <plugin name="cordova-plugin-vibration" spec="3.1.0" />
    <plugin name="cordova-plugin-taptic-engine" spec="2.1.0" />
    <plugin name="onesignal-cordova-plugin" spec="5.2.7" />
    <plugin name="phonegap-plugin-barcodescanner" spec="8.0.1">
        <variable name="ANDROID_SUPPORT_V4_VERSION" value="28.+" />
        <variable name="CAMERA_USAGE_DESCRIPTION" value="Scan QR-Codes" />
    </plugin>
    <plugin name="cordova-plugin-cocoapod-support" spec="^1.6.2" />
    <plugin name="cordova-plugin-audioinput" spec="^1.0.2" />
    <plugin name="cordova-plugin-add-swift-support" spec="2.0.1" />
    <plugin name="cordova-plugin-zeroconf" spec="^1.4.2" />
    <plugin name="cordova-plugin-fingerprint-aio" spec="6.0.0">
        <variable name="FACEID_USAGE_DESCRIPTION" value="Login now..." />
    </plugin>
    <engine name="ios" spec="^4.5.5" />
    <access origin="*" />
    <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
        <application android:usesCleartextTraffic="true" />
    </edit-config>
    <allow-navigation href="*" />
</widget>
