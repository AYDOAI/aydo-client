{
  "name": "AYDO",
  "version": "1.2.7",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:test": "ng serve --configuration=testing",
    "start:android": "ionic cap run android -l --external",
    "start:ios": "ionic cap run ios -l --external",
    "build": "ng build",
    "build:testing": "ng build --configuration testing",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:android": "ionic build --platform='android' && npx cap sync android && ionic cap open android",
    "build:android:test": "ionic build --configuration testing --platform='android' && npx cap sync android && ionic cap open android",
    "build:ios": "ionic build --platform='ios' && npx cap sync ios && ionic cap open ios",
    "lint": "ng lint --fix",
    "format": "prettier --write ./src",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.0.0",
    "@angular/common": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/forms": "^18.0.0",
    "@angular/google-maps": "^18.0.0",
    "@angular/platform-browser": "^18.0.0",
    "@angular/platform-browser-dynamic": "^18.0.0",
    "@angular/router": "^18.0.0",
    "@auth0/angular-jwt": "^5.2.0",
    "@awesome-cordova-plugins/in-app-browser": "^6.12.0",
    "@capacitor-community/apple-sign-in": "^7.0.0",
    "@capacitor-mlkit/barcode-scanning": "^7.1.0",
    "@capacitor/android": "^7.0.1",
    "@capacitor/app": "^7.0.0",
    "@capacitor/assets": "2.0.4",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/cli": "^7.0.1",
    "@capacitor/clipboard": "^7.0.0",
    "@capacitor/core": "^7.0.1",
    "@capacitor/geolocation": "^7.1.1",
    "@capacitor/ios": "^7.0.1",
    "@capacitor/network": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capgo/capacitor-navigation-bar": "^7.1.2",
    "@ionic/angular": "^8.2.6",
    "@ionic/storage": "^4.0.0",
    "@metamask/detect-provider": "^2.0.0",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-solflare": "^0.6.28",
    "@solana/web3.js": "^1.98.0",
    "@wagmi/connectors": "^5.7.5",
    "@wagmi/core": "^2.16.3",
    "cordova-plugin-inappbrowser": "^6.0.0",
    "ng-click-outside2": "^16.0.0",
    "ngx-captcha": "^13.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "viem": "^2.22.21",
    "web3": "^4.11.1",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.0",
    "@angular-eslint/builder": "19.0.2",
    "@angular-eslint/eslint-plugin": "19.0.2",
    "@angular-eslint/eslint-plugin-template": "19.0.2",
    "@angular-eslint/schematics": "19.0.2",
    "@angular-eslint/template-parser": "19.0.2",
    "@angular/cli": "18.2.12",
    "@angular/compiler-cli": "^18.0.0",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "7.11.0",
    "@typescript-eslint/parser": "7.11.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "typescript": "~5.4.2"
  },
  "lint-staged": {
    "*.{ts,scss,html}": [
      "eslint --fix"
    ],
    "*.{json,css,md,ts,scss,html}": [
      "prettier --write"
    ]
  }
}
